{
    "name": "duyunapp/duyun-backup-manager",
    "description": "A Laravel package for creating and managing backups.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Omar Saiouf",
            "email": "omersaiouf@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "laravel/framework": "^12.0",
        "spatie/simple-excel": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "DuyunApp\\DuyunBackupManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DuyunApp\\DuyunBackupManager\\Tests\\": "tests/",
            "DuyunApp\\DuyunBackupManager\\Exporters\\": "Exporters/",
            "DuyunApp\\DuyunBackupManager\\Contracts\\": "Contracts/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DuyunApp\\DuyunBackupManager\\BackupManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}